# ==============================================================================
# SOIL — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env antes de subir em produção ou via Docker Compose
# ==============================================================================

# Servidor HTTP (Fastify)
PORT=3000
HOST=0.0.0.0
USE_IN_MEMORY_DB=false

# Segurança JWT (HS256)
JWT_SECRET=soil-prod-jwt-secret-change-me-2026

# Banco de Dados MySQL 8.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_EXTERNAL_PORT=3306
DB_NAME=soil
DB_USER=soil_user
DB_PASSWORD=soil_pass_2026
DB_ROOT_PASSWORD=soil_root_2026

# Disparo de Orçamentos por E-mail (Nodemailer SMTP / Mailpit Local)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Orcamentos SOIL <noreply@engine.lat>"

# Portas do Mailpit (apenas Docker Compose)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
