{
  "name": "@soil/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/presentation/server.ts",
    "dev": "tsx watch src/presentation/server.ts",
    "dev:demo": "tsx -e \"process.env.USE_IN_MEMORY_DB='true'; import('./src/presentation/server.ts')\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@soil/shared": "*",
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "jose": "^6.0.8",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.6"
  }
}
